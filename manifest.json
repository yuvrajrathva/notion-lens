{
  "name": "Notion Lens",
  "description": "Extension of Notion RAG.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "notion-lens.png"
    },
    "default_title": "Notion Lens"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting"]
}
