{
  "name": "Notion Lens",
  "description": "Extension of Notion RAG.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "notion-lens.png"
    },
    "default_title": "Click to open Notion Lens Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "sidePanel", "storage"],
  "host_permissions": ["http://localhost:8000/*"]
}
